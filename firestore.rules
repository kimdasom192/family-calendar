rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function family() {
      return request.auth != null
        && request.auth.token.email in ['me@family-cal.app', 'hus@family-cal.app', 'kid1@family-cal.app', 'kid2@family-cal.app'];
    }
    match /{document=**} {
      allow read, write: if family();
    }
  }
}
